<Window
    AllowsTransparency="True"
    Background="{x:Null}"
    FontFamily="{DynamicResource NotoMusic}"
    FontSize="11"
    Height="459"
    Icon="/Resources/Icon.ico"
    Loaded="Window_Loaded"
    MouseDown="Window_MouseDown"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Title="MainWindow"
    Topmost="True"
    UseLayoutRounding="True"
    Width="587"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    x:Class="CrystalFolders.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:CrystalFolders"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:CrystalFolders.Properties"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Height="459"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Width="587">
        <Grid.Resources>
            <local:FolderStateIconConverter x:Key="FolderStateIconConverter" />
            <local:IconLocationIconConverter x:Key="IconLocationIconConverter" />
            <local:LeadingEllipsisConverter x:Key="LeadingEllipsisConverter" />
            <local:FolderStateTooltipConverter x:Key="FolderStateTooltipConverter" />
            <local:IconLocationTooltipConverter x:Key="IconLocationTooltipConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="476" />
        </Grid.RowDefinitions>
        <Border
            Background="{DynamicResource Primary}"
            CornerRadius="7,7,0,0"
            Height="5"
            HorizontalAlignment="Left"
            Margin="0,0,0,471"
            Width="250"
            d:IsLocked="True"
            x:Name="Deco1" />
        <Border
            Background="{DynamicResource Primary}"
            CornerRadius="7,7,0,0"
            Height="5"
            HorizontalAlignment="Left"
            Margin="258,0,0,471"
            Width="329"
            d:IsLocked="True"
            x:Name="Deco2" />
        <Border
            Background="White"
            CornerRadius="0,0,8,8"
            Height="454"
            HorizontalAlignment="Left"
            Margin="258,5,0,0"
            VerticalAlignment="Top"
            Width="330"
            d:IsLocked="True"
            x:Name="Bg1" />
        <Border
            Background="White"
            CornerRadius="0,0,8,8"
            Height="454"
            HorizontalAlignment="Left"
            Margin="0,5,0,0"
            VerticalAlignment="Top"
            Width="250"
            d:IsLocked="True"
            x:Name="Bg2" />
        <ListBox
            AllowDrop="True"
            BorderBrush="#FFD9DBEF"
            Drop="DropList_Drop"
            Height="279"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Stretch"
            Margin="24,70,0,0"
            MouseDoubleClick="DropList_MouseDoubleClick"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            VerticalAlignment="Top"
            Width="202"
            x:Name="DropList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  Path de la Carpeta  -->
                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding Converter={StaticResource LeadingEllipsisConverter}}"
                            ToolTip="{Binding}"
                            VerticalAlignment="Center" />
                        <!--  Icono de Estado de la Carpeta  -->
                        <Image
                            Grid.Column="0"
                            Height="15"
                            Margin="1,0,2,0"
                            Source="{Binding Converter={StaticResource FolderStateIconConverter}}"
                            ToolTip="{Binding Converter={StaticResource FolderStateTooltipConverter}}"
                            VerticalAlignment="Center"
                            Width="15" />
                        <!--  Icono de Localización del Icono  -->
                        <Rectangle
                            Fill="{DynamicResource Primary}"
                            Grid.Column="1"
                            Height="15"
                            Margin="1,0,2,0"
                            ToolTip="{Binding Converter={StaticResource IconLocationTooltipConverter}}"
                            VerticalAlignment="Center"
                            Width="15">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Converter={StaticResource IconLocationIconConverter}}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="5,1,5,4" />
                    <Setter Property="Margin" Value="0,2,0,2" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="2" />
                </Style>
            </ListBox.Resources>
        </ListBox>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="15"
            HorizontalAlignment="Left"
            Margin="24,30,0,0"
            RenderTransformOrigin="0.5,0.4"
            VerticalAlignment="Top"
            Width="15">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/folder.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="15"
            HorizontalAlignment="Left"
            Margin="289,350,0,0"
            VerticalAlignment="Top"
            Width="15">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/save.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="15"
            HorizontalAlignment="Left"
            Margin="289,220,0,0"
            VerticalAlignment="Top"
            Width="15">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/section-add.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Button
            BorderThickness="0,0,0,0"
            Click="Customize_Click"
            FontSize="11"
            Foreground="White"
            Height="28"
            HorizontalAlignment="Left"
            Margin="289,393,0,0"
            Padding="10,-3,10,1"
            Style="{StaticResource ButtonPrimary}"
            VerticalAlignment="Top"
            Width="267"
            x:Name="Customize">
            <TextBlock><Run
                    FontSize="13"
                    Text="{x:Static properties:Resources.C}"
                    x:Name="CBtn_Letter" /><Run
                    FontSize="12"
                    Text="{x:Static properties:Resources.ustomize}"
                    x:Name="CBtn_Text" /></TextBlock>
        </Button>
        <Image
            Height="128"
            HorizontalAlignment="Left"
            Margin="420,69,0,0"
            VerticalAlignment="Top"
            Width="128"
            x:Name="Iconpic" />
        <hc:DashedBorder
            BorderBrush="#FFD9DBEF"
            BorderDashCap="Round"
            BorderDashOffset="1"
            BorderDashThickness="1"
            BorderThickness="1,1,1,1"
            CornerRadius="4,4,4,4"
            Height="128"
            HorizontalAlignment="Left"
            Margin="421,69,0,0"
            Padding="0"
            VerticalAlignment="Top"
            Width="128"
            x:Name="Icon_border" />
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="30"
            HorizontalAlignment="Left"
            Margin="470,118,0,0"
            VerticalAlignment="Top"
            Width="30"
            x:Name="Icon_cross">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/Cross.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="15"
            HorizontalAlignment="Left"
            Margin="289,30,0,0"
            VerticalAlignment="Top"
            Width="15"
            x:Name="Icn_Archivo">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/image.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Button
            Background="#FFF5F5F9"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            Click="ChooseBtn_Click"
            Content="{x:Static properties:Resources.Choose}"
            FontSize="11"
            Foreground="#FF383838"
            Height="24"
            HorizontalAlignment="Left"
            IsManipulationEnabled="True"
            Margin="296,98,0,0"
            Padding="10,-2,10,1"
            VerticalAlignment="Top"
            Width="107"
            x:Name="ChooseBtn" />
        <Button
            Background="#FFF5F5F9"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            Click="RestoreBtn_Click"
            Content="{x:Static properties:Resources.Restore}"
            FontSize="11"
            Foreground="#FF383838"
            Height="24"
            HorizontalAlignment="Left"
            IsManipulationEnabled="True"
            Margin="296,142,0,0"
            Padding="10,-2,10,1"
            VerticalAlignment="Top"
            Width="107"
            x:Name="RestoreBtn" />
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="24"
            HorizontalAlignment="Left"
            Margin="26,372,0,0"
            VerticalAlignment="Top"
            Width="24">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/document.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="24"
            HorizontalAlignment="Left"
            Margin="102,408,0,0"
            VerticalAlignment="Top"
            Width="24">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/picture.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="24"
            HorizontalAlignment="Left"
            Margin="177,372,0,0"
            VerticalAlignment="Top"
            Width="24">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/movie.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="24"
            HorizontalAlignment="Left"
            Margin="102,372,0,0"
            VerticalAlignment="Top"
            Width="24">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/disc.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle
            Fill="{DynamicResource Primary}"
            Height="24"
            HorizontalAlignment="Left"
            Margin="26,408,0,0"
            VerticalAlignment="Top"
            Width="24">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/screen.png" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <CheckBox
            BorderBrush="{DynamicResource Border}"
            Checked="Desktop_Checked"
            Content=""
            HorizontalAlignment="Left"
            Margin="54,409,0,0"
            Unchecked="Desktop_Unchecked"
            VerticalAlignment="Top"
            Width="16"
            x:Name="Desktop" />
        <CheckBox
            BorderBrush="{DynamicResource Border}"
            Checked="Music_Checked"
            Content=""
            HorizontalAlignment="Left"
            Margin="131,373,0,0"
            Unchecked="Music_Unchecked"
            VerticalAlignment="Top"
            Width="16"
            x:Name="Music" />
        <CheckBox
            BorderBrush="{DynamicResource Border}"
            Checked="Pictures_Checked"
            Content=""
            HorizontalAlignment="Left"
            Margin="131,409,0,0"
            Unchecked="Pictures_Unchecked"
            VerticalAlignment="Top"
            Width="16"
            x:Name="Pictures" />
        <CheckBox
            BorderBrush="{DynamicResource Border}"
