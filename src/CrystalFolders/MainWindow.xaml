            Content=""
            HorizontalAlignment="Left"
            Margin="54,373,0,0"
            Unchecked="Documents_Unchecked"
            VerticalAlignment="Top"
            Width="16"
            x:Name="Documents" />
        <Border
            Background="{DynamicResource Primary}"
            BorderBrush="#FF000000"
            CornerRadius="1.5,1.5,1.5,1.5"
            Height="3"
            HorizontalAlignment="Left"
            Margin="68,69,0,404"
            Width="116" />
        <Separator
            Background="Gainsboro"
            Height="16"
            HorizontalAlignment="Left"
            Margin="338,30,0,0"
            RenderTransformOrigin="0.505,1.412"
            VerticalAlignment="Top"
            Width="145" />
        <Border
            Background="{DynamicResource Primary}"
            BorderBrush="#FF000000"
            CornerRadius="0,0,3,1.5"
            HorizontalAlignment="Left"
            Margin="322,166,0,308"
            Width="55" />
        <Border
            Background="{DynamicResource Primary}"
            BorderBrush="#FF000000"
            CornerRadius="0,0,3,1.5"
            HorizontalAlignment="Left"
            Margin="322,122,0,352"
            Width="55" />
        <Button
            Background="#FF888888"
            BorderBrush="{x:Null}"
            Click="Remove_Click"
            Foreground="{x:Null}"
            Height="15"
            HorizontalAlignment="Left"
            Margin="214,21,0,0"
            Padding="0,0,0,0"
            VerticalAlignment="Top"
            Width="15"
            hc:BorderElement.CornerRadius="0"
            x:Name="Remove">
            <Button.OpacityMask>
                <ImageBrush ImageSource="/Resources/minus-circle.png" />
            </Button.OpacityMask>
        </Button>
        <Button
            Background="#FF888888"
            BorderBrush="{x:Null}"
            Click="Exit_Click"
            Foreground="{x:Null}"
            Height="15"
            HorizontalAlignment="Left"
            Margin="541,21,0,0"
            Padding="0,0,0,0"
            VerticalAlignment="Top"
            Width="15"
            hc:BorderElement.CornerRadius="0"
            x:Name="Exit">
            <Button.OpacityMask>
                <ImageBrush ImageSource="/Resources/x-circle.png" />
            </Button.OpacityMask>
        </Button>
        <ToggleButton
            Checked="SlideSub_Checked"
            Content=""
            Foreground="#FF212121"
            Height="18"
            HorizontalAlignment="Left"
            IsChecked="False"
            Margin="332,264,0,0"
            Style="{StaticResource ToggleButtonSwitch}"
            Unchecked="SlideSub_Unchecked"
            VerticalAlignment="Top"
            Width="27"
            x:Name="SlideSub" />
        <hc:CircleProgressBar
            Height="25"
            HorizontalAlignment="Left"
            IsIndeterminate="False"
            Margin="335,260,0,0"
            ShowText="False"
            Value="80"
            VerticalAlignment="Top"
            Visibility="Hidden"
            Width="25"
            x:Name="LoadingSub" />
        <Label
            Background="{x:Null}"
            BorderBrush="{x:Null}"
            BorderThickness="0,0,0,0"
            Content="{x:Static properties:Resources.IncludeSubfolders}"
            Height="19"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Margin="371,263,0,0"
            Padding="0,-9,0,2"
            RenderTransformOrigin="0.875,0.538"
            SizeChanged="LabelSub_SizeChanged"
            VerticalAlignment="Top"
            x:Name="LabelSub" />
        <ToggleButton
            Checked="SlidePortable_Checked"
            Click="SlidePortable_Click"
            Content=""
            Foreground="#FF212121"
            Height="18"
            HorizontalAlignment="Left"
            IsChecked="False"
            Margin="332,301,0,0"
            Style="{StaticResource ToggleButtonSwitch}"
            Unchecked="SlidePortable_Unchecked"
            VerticalAlignment="Top"
            Width="27"
            x:Name="SlidePortable" />
        <Label
            Background="{x:Null}"
            BorderBrush="{x:Null}"
            BorderThickness="0,0,0,0"
            Content="{x:Static properties:Resources.ConfigureAsPortable}"
            Height="19"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Margin="371,300,0,0"
            Padding="0,-9,0,2"
            RenderTransformOrigin="0.875,0.538"
            VerticalAlignment="Top"
            Width="116"
            x:Name="LabelPortable" />
        <Separator
            Background="Gainsboro"
            Height="16"
            HorizontalAlignment="Left"
            Margin="351,220,0,0"
            RenderTransformOrigin="0.505,1.412"
            VerticalAlignment="Top"
            Width="205" />
        <Separator
            Background="Gainsboro"
            Height="16"
            HorizontalAlignment="Left"
            Margin="351,350,0,0"
            RenderTransformOrigin="0.505,1.412"
            VerticalAlignment="Top"
            Width="205" />
        <Separator
            Background="Gainsboro"
            Height="16"
            HorizontalAlignment="Left"
            Margin="90,30,0,0"
            RenderTransformOrigin="0.505,1.412"
            VerticalAlignment="Top"
            Width="114" />
        <Button
            Background="#FF888888"
            BorderBrush="{x:Null}"
            Click="ClearList_Click"
            Foreground="{x:Null}"
            Height="15"
            HorizontalAlignment="Left"
            Margin="517,21,0,0"
            Padding="0,0,0,0"
            VerticalAlignment="Top"
            Width="15"
            hc:BorderElement.CornerRadius="0"
            x:Name="ClearList">
            <Button.OpacityMask>
                <ImageBrush ImageSource="/Resources/refresh-alt.png" />
            </Button.OpacityMask>
        </Button>
        <hc:Badge
            Background="#FFF5F5F9"
            BadgeMargin="0,-4,-4,0"
            BorderBrush="#FFC9CBE2"
            BorderThickness="1,1,1,1"
            FontSize="11"
            Foreground="#FF383838"
            Grid.IsSharedSizeScope="True"
            Height="34"
            HorizontalContentAlignment="Right"
            IsEnabled="False"
            Margin="530,387,31,0"
            Maximum="999"
            Padding="5,-3,5,0"
            RenderTransformOrigin="0.474,0.45"
            Value="0"
            VerticalAlignment="Top"
            Visibility="Visible"
            x:Name="Dot" />
        <hc:Badge
            Background="{DynamicResource Primary}"
            BadgeMargin="0,-4,-4,0"
            BorderBrush="#FFC9CBE2"
            BorderThickness="0,0,0,0"
            FontSize="10"
            Foreground="White"
            Grid.IsSharedSizeScope="True"
            Height="11"
            HorizontalContentAlignment="Left"
            IsEnabled="False"
            Margin="476,266,88,0"
            Maximum="999"
            Padding="5,-3,5,1"
            RenderTransformOrigin="0.474,0.45"
            Value="0"
            VerticalAlignment="Top"
            Visibility="Visible"
            Width="23"
            x:Name="Dotsub" />
        <Label
            BorderBrush="{x:Null}"
            BorderThickness="0,0,0,0"
            Content="{x:Static properties:Resources.Folders}"
            Height="19"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Margin="39,26,0,0"
            Padding="10,0,10,0"
            RenderTransformOrigin="0.875,0.538"
            VerticalAlignment="Top" />
        <Label
            BorderBrush="{x:Null}"
            BorderThickness="0,0,0,0"
            Content="{x:Static properties:Resources.Icon}"
            Height="19"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Margin="304,26,0,0"
            Padding="10,0,10,0"
            RenderTransformOrigin="0.875,0.538"
            VerticalAlignment="Top" />
        <Label
            BorderBrush="{x:Null}"
            BorderThickness="0,0,0,0"
            Content="{x:Static properties:Resources.Options}"
            Height="19"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Margin="304,216,0,0"
            Padding="10,0,10,0"
            RenderTransformOrigin="0.875,0.538"
            VerticalAlignment="Top" />
        <Label
            BorderBrush="{x:Null}"
            BorderThickness="0,0,0,0"
            Content="{x:Static properties:Resources.Changes}"
            Height="19"
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Margin="304,346,0,0"
            Padding="10,0,10,0"
            RenderTransformOrigin="0.875,0.538"
            VerticalAlignment="Top" />
        <Border
            BorderBrush="#FFE3E3E3"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,7,7"
            Grid.Row="0"
            Margin="0,5,337,17"
            d:IsLocked="True"
            x:Name="Border1" />
        <Border
            BorderBrush="#FFE3E3E3"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,7,7"
            Grid.Row="0"
            Margin="258,5,0,17"
